@@ -0,0 +1,402 @@
+// Local addition (melee-llm): Slippi Lab's character renderer for live games, without a replay file.
+//
+// The melee-llm match registry streams compact samples per frame: [frame, p1, p2] where each player is
+// [x, y, facing(1|-1), actionStateId, actionFrame, percent, stocks, shield, flags, internalCharacterId]
+// (flags: 1 invulnerable, 2 hitstun, 4 grounded, 8 shielding, 16 offstage). LiveView draws one sample on a
+// canvas with the same animation zips, action → animation mapping and transforms as the replay viewer
+// (state/replayStore.tsx computeRenderData, components/viewer/{Player,Camera,Stage}.tsx). The Brute page draws
+// its recorded clips with drawFighter, drawShield and drawShine on its own canvas. Built with
+// esbuild to dist/live-renderer.js (see package.json "build:live").
+import {
+  fodInitialLeftPlatformHeight,
+  fodInitialRightPlatformHeight,
+} from "~/common/constants";
+import {
+  actionNameById,
+  characterNameByExternalId,
+  characterNameByInternalId,
+} from "~/common/ids";
+import { fetchAnimations, CharacterAnimations } from "~/viewer/animationCache";
+import { actionMapByInternalId } from "~/viewer/characters";
+
+export type PlayerSample = [number, number, number, number, number, number, number, number, number, number];
+export type Sample = [number, ...(PlayerSample | null)[]];
+
+type Pt = [number, number];
+interface StageDef {
+  main: Pt[];
+  platforms: Pt[][];
+  blastzones: [Pt, Pt];
+  dashed?: number[]; // platforms whose height we don't know (FoD moves them)
+}
+
+const pts = (s: string): Pt[] =>
+  s.trim().split(/\s+/).map((p) => p.split(",").map(Number) as Pt);
+
+// Copied from components/viewer/Stage.tsx (there they live inside JSX components).
+const fodL = fodInitialLeftPlatformHeight * 0.80625;
+const fodR = fodInitialRightPlatformHeight * 0.80625;
+export const STAGES: Record<string, StageDef> = {
+  BATTLEFIELD: {
+    main: pts("-68.4,0 68.4,0 65,-6 36,-19 39,-21 33,-25 30,-29 29,-35 10,-40 10,-30 -10,-30 -10,-40 -29,-35 -30,-29 -33,-25 -39,-21 -36,-19 -65,-6 -68.4,0"),
+    platforms: [pts("-57.6,27.2 -20,27.2"), pts("20,27.2 57.6,27.2"), pts("-18.8,54.4 18.8,54.4")],
+    blastzones: [[-224, -108.8], [224, 200]],
+  },
+  DREAMLAND: {
+    main: pts("-76.5,-11 -77.25,0 77.25,0 76.5,-11 65.75,-36 -65.75,-36 -76.5,-11"),
+    platforms: [pts("-61.393,30.142 -31.725,30.142"), pts("31.704,30.243 63.075,30.243"), pts("-19.018,51.425 19.017,51.425")],
+    blastzones: [[-255, -123], [255, 250]],
+  },
+  FINAL_DESTINATION: {
+    main: pts("-85.6,0 85.6,0 85.6,-10 65,-20 65,-30 60,-47 50,-55 45,-56 -45,-56 -50,-55 -60,-47 -65,-30 -65,-20 -85.6,-10 -85.6,0"),
+    platforms: [],
+    blastzones: [[-246, -140], [246, 188]],
+  },
+  YOSHIS_STORY: {
+    main: pts("-54,-91 -54,-47 -53,-46 -53,-31 -54,-30 -54,-28 -53,-27 -53,-12 -54,-11 -55,-8 -56,-7 -56,-3.5 -39,0 39,0 56,-3.5 56,-7 55,-8 54,-11 53,-12 53,-27 54,-28 54,-30 53,-31 53,-46 54,-47 54,-91 -54,-91"),
+    platforms: [pts("-59.5,23.45 -28,23.45"), pts("28,23.45 59.5,23.45"), pts("-15.75,42 15.75,42")],
+    blastzones: [[-175.7, -91], [173.6, 169]],
+  },
+  FOUNTAIN_OF_DREAMS: {
+    main: pts("-63.33,0.62 -53.5,0.62 -51,0 51,0 53.5,0.62 63.33,0.62 63.35,-4.5 59.33,-15 56.9,-19.5 55,-27 52,-32 48,-38 41,-42 19,-49.5 13,-54.5 10,-62 8.8,-72 8.8,-150 -8.8,-150 -8.8,-72 -10,-62 -13,-54.5 -19,-49.5 -41,-42 -48,-38 -52,-32 -55,-27 -56.9,-19.5 -59.33,-15 -63.35,-4.5 -63.33,0.62"),
+    platforms: [[[-49.5, fodL], [-21, fodL]], [[21, fodR], [49.5, fodR]], pts("-14.25,42.75 14.25,42.75")],
+    blastzones: [[-198.75, -146.25], [198.75, 202.5]],
+    dashed: [0, 1],
+  },
+  POKEMON_STADIUM: {
+    main: pts("87.75,0 87.75,-4 73.75,-15 73.75,-17.75 60,-17.75 60,-38 15,-60 15,-112 -15,-112 -15,-60 -60,-38 -60,-17.75 -73.75,-17.75 -73.75,-15 -87.75,-4 -87.75,0 87.75,0"),
+    platforms: [pts("-55,25 -25,25"), pts("25,25 55,25")],
+    blastzones: [[-230, -111], [230, 180]],
+  },
+};
+
+// Yoshi's Story's Randall, simplified from Stage.tsx (straight runs only; corners are skipped).
+function randall(frame: number): Pt[] | null {
+  const lap = (((frame - 123 + 1200) % 1200) + 1200) % 1200;
+  const w = 11.9;
+  if (lap > 476 && lap < 1016) {
+    const x = 101.235443115234 - 0.35484 * (lap - 477);
+    return [[x - w, -13.64989], [x, -13.64989]];
+  }
+  if (lap > 1022 && lap < 1069) {
+    const y = -15.2778692245483 - 0.354839325 * (lap - 1023);
+    return [[-103.6, y], [-91.7, y]];
+  }
+  if (lap > 1075 || lap < 416) {
+    const x = -101.850006103516 + 0.35484 * (lap + (lap < 416 ? 125 : -1076));
+    return [[x, -33.2489], [x + w, -33.2489]];
+  }
+  if (lap > 423 && lap < 469) {
+    const y = -31.16023254394531 + 0.354839325 * (lap - 424);
+    return [[91.35, y], [103.25, y]];
+  }
+  return null;
+}
+
+function externalId(internalId: number): number {
+  const name = characterNameByInternalId[internalId] as string;
+  const ext = name === "Popo" || name === "Nana" ? "Ice Climbers" : name;
+  return (characterNameByExternalId as readonly string[]).indexOf(ext);
+}
+
+const animations = new Map<number, CharacterAnimations | "loading" | "failed">();
+const pathCache = new Map<string, Path2D>();
+
+const loading = new Map<number, Promise<boolean>>();
+
+// Fetches a character's animations once. Resolves to false when there are none to draw.
+export function preload(internalId: number): Promise<boolean> {
+  const ext = externalId(internalId);
+  let p = loading.get(ext);
+  if (!p) {
+    p = ext < 0 ? Promise.resolve(false) : fetchAnimations(ext).then(
+      (a) => { animations.set(ext, a); return true; },
+      () => { animations.set(ext, "failed"); return false; });
+    loading.set(ext, p);
+  }
+  return p;
+}
+
+function animationsFor(internalId: number, onLoad: () => void): CharacterAnimations | undefined {
+  const ext = externalId(internalId);
+  const got = animations.get(ext);
+  if (got === undefined && ext >= 0) {
+    animations.set(ext, "loading");
+    void preload(internalId).then((ok) => ok && onLoad());
+  }
+  return typeof got === "object" ? got : undefined;
+}
+
+function animationPath(anims: CharacterAnimations, animationName: string, actionFrame: number): Path2D | undefined {
+  const frames = anims[animationName];
+  if (!frames?.length) return undefined;
+  const index = Math.floor(Math.max(0, actionFrame)) % frames.length;
+  let d = frames[index];
+  if (d?.startsWith("frame")) d = frames[Number(d.slice("frame".length))];
+  if (!d) return undefined;
+  const key = `${animationName}:${index}:${d.length}:${d.slice(0, 24)}`;
+  let p = pathCache.get(key);
+  if (!p) {
+    p = new Path2D(d);
+    if (pathCache.size > 4000) pathCache.clear();
+    pathCache.set(key, p);
+  }
+  return p;
+}
+
+// Same rule as replayStore's actionFollowsFacingDirection.
+const followsFacing = (name: string) => name.includes("Jump") || name === "SpecialHi" || name === "SpecialAirHi";
+const SHIELD_ANIMS = ["GuardOn", "Guard", "GuardReflect", "GuardDamage"];
+
+// One fighter on one frame. drawFighter, drawShield and drawShine draw in world coordinates (y up) on a
+// context the caller has already transformed, and keep no state: any frame can be drawn in any order.
+export interface Fighter {
+  x: number;
+  y: number;
+  facing: number; // 1 | -1 on this frame
+  facingAtStart?: number; // on the first frame of the action (replayStore fixes facing for the whole action)
+  actionId: number;
+  actionFrame: number;
+  charId: number; // internal character id
+  color: string;
+  outline?: string;
+  outlineWidth?: number; // in model units: a world unit is about 10 / scale of them
+  dash?: number[]; // outline dash, in model units
+  alpha?: number; // of the fill
+  from?: Pt; // the position one frame earlier: a tumbling fighter (DamageFlyRoll) is turned along his path
+}
+export interface Pose {
+  animationName: string;
+  face: number;
+  shield: boolean; // the shield bubble is up in this animation
+  shine: boolean; // Fox's or Falco's reflector is out
+}
+
+function characterOf(charId: number) {
+  return actionMapByInternalId[charId];
+}
+
+// Fills the fighter's silhouette. Returns null while the animations load (onLoad fires when they arrive) or
+// when the action has no animation: the caller then draws its own stand-in.
+export function drawFighter(ctx: CanvasRenderingContext2D, f: Fighter, onLoad: () => void = () => {}): Pose | null {
+  const data = characterOf(f.charId);
+  if (!data) return null;
+  const actionName = actionNameById[f.actionId];
+  const animationName = data.animationMap.get(actionName) ?? data.specialsMap.get(f.actionId) ?? actionName;
+  const anims = animationsFor(f.charId, onLoad);
+  const path = anims && animationName ? animationPath(anims, animationName, f.actionFrame) : undefined;
+  if (!path) return null;
+  const face = followsFacing(animationName) ? f.facing : f.facingAtStart ?? f.facing;
+  ctx.save();
+  // computeRenderData's transforms, in canvas order
+  ctx.translate(f.x, f.y);
+  if (animationName === "DamageFlyRoll" && f.from) {
+    ctx.translate(0, 8);
+    ctx.rotate(Math.atan2(f.y - f.from[1], f.x - f.from[0]) - Math.PI / 2);
+    ctx.translate(0, -8);
+  }
+  ctx.scale(data.scale, data.scale);
+  ctx.scale(face, 1);
+  ctx.scale(0.1, -0.1);
+  ctx.translate(-500, -500);
+  ctx.fillStyle = f.color;
+  ctx.globalAlpha = f.alpha ?? 1;
+  ctx.fill(path);
+  ctx.globalAlpha = 1;
+  ctx.lineWidth = f.outlineWidth ?? 2;
+  ctx.strokeStyle = f.outline ?? "#0b0d12";
+  ctx.setLineDash(f.dash ?? []);
+  ctx.stroke(path);
+  ctx.restore();
+  const character = characterNameByInternalId[f.charId] as string;
+  return {
+    animationName,
+    face,
+    shield: SHIELD_ANIMS.includes(animationName),
+    shine: (character === "Fox" || character === "Falco") && (animationName.includes("SpecialLw") || animationName.includes("SpecialAirLw")),
+  };
+}
+
+// Player.tsx Shield with the trigger fully pressed. health is 0..60.
+export function drawShield(ctx: CanvasRenderingContext2D, f: Fighter, health: number, alpha = 0.45) {
+  const data = characterOf(f.charId);
+  if (!data) return;
+  const size = data.shieldSize * (((health * 0.5) / 60) * 0.85 + 0.15);
+  ctx.save();
+  ctx.globalAlpha = alpha;
+  ctx.fillStyle = f.color;
+  ctx.beginPath();
+  ctx.arc(f.x + data.shieldOffset[0] * f.facing, f.y + data.shieldOffset[1], size, 0, Math.PI * 2);
+  ctx.fill();
+  ctx.restore();
+}
+
+// Player.tsx Shine: the reflector as a hexagonal ring (same centre, radius and hole).
+export function drawShine(ctx: CanvasRenderingContext2D, f: Fighter, color = "#8abce9", alpha = 1) {
+  const data = characterOf(f.charId);
+  if (!data) return;
+  const cy = f.y + (data.shieldOffset[1] * 3) / 4;
+  const hex = (r: number) => {
+    for (let a = 0; a < 6; a++) {
+      const x = f.x + r * Math.sin((a * Math.PI) / 3), y = cy + r * Math.cos((a * Math.PI) / 3);
+      if (a) ctx.lineTo(x, y); else ctx.moveTo(x, y);
+    }
+    ctx.closePath();
+  };
+  ctx.save();
+  ctx.globalAlpha = alpha;
+  ctx.fillStyle = color;
+  ctx.beginPath();
+  hex(6);
+  hex(6 * 0.6);
+  ctx.fill("evenodd");
+  ctx.restore();
+}
+
+export interface LiveViewOptions {
+  stage: string; // libmelee Stage name, e.g. BATTLEFIELD
+  colors?: string[]; // per port (index 0 = P1)
+  background?: string;
+  follow?: boolean; // camera follows the players (true) or frames the whole stage (false)
+}
+
+export class LiveView {
+  canvas: HTMLCanvasElement;
+  ctx: CanvasRenderingContext2D;
+  opts: Required<LiveViewOptions>;
+  stage: StageDef | undefined;
+  last: Sample | null = null;
+  facingAtStart: Record<number, number> = {};
+  prevAction: Record<number, [number, number]> = {};
+  prevPos: Record<number, Pt> = {};
+  center: Pt | null = null;
+  scale: number | null = null;
+
+  constructor(canvas: HTMLCanvasElement, opts: LiveViewOptions) {
+    this.canvas = canvas;
+    this.ctx = canvas.getContext("2d")!;
+    this.opts = { colors: ["#f0605d", "#4fa3ff", "#f2b84b", "#3ecf8e"], background: "#0d1017", follow: true, ...opts };
+    this.stage = STAGES[opts.stage];
+  }
+
+  setStage(stage: string) {
+    this.opts.stage = stage;
+    this.stage = STAGES[stage];
+  }
+
+  draw(sample: Sample) {
+    this.last = sample;
+    const { canvas, ctx } = this;
+    const dpr = window.devicePixelRatio || 1;
+    const w = canvas.clientWidth, h = canvas.clientHeight;
+    if (!w || !h) return;
+    if (canvas.width !== Math.round(w * dpr) || canvas.height !== Math.round(h * dpr)) {
+      canvas.width = Math.round(w * dpr);
+      canvas.height = Math.round(h * dpr);
+    }
+    ctx.setTransform(1, 0, 0, 1, 0, 0);
+    ctx.fillStyle = this.opts.background;
+    ctx.fillRect(0, 0, canvas.width, canvas.height);
+    const [frame, ...players] = sample;
+    this.camera(players, w, h);
+    const s = this.scale! * dpr;
+    // world: y up, origin at the camera centre
+    ctx.setTransform(s, 0, 0, -s, canvas.width / 2 - this.center![0] * s, canvas.height / 2 + this.center![1] * s);
+    this.drawStage(frame, s);
+    players.forEach((p, i) => p && this.drawPlayer(i, p, s));
+  }
+
+  redraw() {
+    if (this.last) this.draw(this.last);
+  }
+
+  private camera(players: (PlayerSample | null)[], w: number, h: number) {
+    const bz = this.stage?.blastzones ?? [[-224, -108], [224, 200]];
+    let cx: number, cy: number, sc: number;
+    if (this.opts.follow) {
+      // Camera.tsx, with a wider minimum so the stage stays in view on small cards
+      const live = players.filter((p): p is PlayerSample => !!p && p[0] > bz[0][0] && p[0] < bz[1][0] && p[1] > bz[0][1] && p[1] < bz[1][1]);
+      const xs = live.map((p) => p[0]).concat(this.stage ? [this.stage.main[0][0] * 0.7, -this.stage.main[0][0] * 0.7] : []);
+      const ys = live.map((p) => p[1]).concat([0]);
+      const pad = 30;
+      const xMin = Math.min(...xs) - pad, xMax = Math.max(...xs) + pad;
+      const yMin = Math.min(...ys) - pad, yMax = Math.max(...ys) + pad;
+      cx = (xMin + xMax) / 2;
+      cy = (yMin + yMax) / 2;
+      sc = Math.min(w / Math.max(xMax - xMin, 170), h / Math.max(yMax - yMin, 120));
+    } else {
+      const xr = 0.62 * (bz[1][0] - bz[0][0]), yr = 0.62 * (bz[1][1] - bz[0][1]);
+      cx = 0;
+      cy = (bz[0][1] + bz[1][1]) / 2 * 0.4;
+      sc = Math.min(w / xr, h / yr);
+    }
+    const k = this.center ? 0.12 : 1;
+    this.center = this.center ? [this.center[0] + (cx - this.center[0]) * k, this.center[1] + (cy - this.center[1]) * k] : [cx, cy];
+    this.scale = this.scale ? this.scale + (sc - this.scale) * k : sc;
+  }
+
+  private drawStage(frame: number, s: number) {
+    const { ctx, stage } = this;
+    if (!stage) return;
+    const [[l, b], [r, t]] = stage.blastzones;
+    ctx.lineWidth = 1 / s;
+    ctx.strokeStyle = "#262c3a";
+    ctx.strokeRect(l, b, r - l, t - b);
+    ctx.beginPath();
+    stage.main.forEach(([x, y], i) => (i ? ctx.lineTo(x, y) : ctx.moveTo(x, y)));
+    ctx.closePath();
+    ctx.fillStyle = "#2a3142";
+    ctx.fill();
+    ctx.strokeStyle = "#4a5266";
+    ctx.stroke();
+    ctx.lineWidth = 2 / s;
+    ctx.strokeStyle = "#8a93a6";
+    const plats = [...stage.platforms];
+    if (this.opts.stage === "YOSHIS_STORY") {
+      const rd = randall(frame);
+      if (rd) plats.push(rd);
+    }
+    plats.forEach((pl, i) => {
+      ctx.setLineDash(stage.dashed?.includes(i) ? [2, 4] : []);
+      ctx.beginPath();
+      ctx.moveTo(pl[0][0], pl[0][1]);
+      ctx.lineTo(pl[1][0], pl[1][1]);
+      ctx.stroke();
+    });
+    ctx.setLineDash([]);
+  }
+
+  private drawPlayer(i: number, p: PlayerSample, s: number) {
+    const { ctx } = this;
+    const [x, y, facing, actionId, actionFrame, , stocks, shield, flags, charId] = p;
+    if (stocks <= 0) return;
+    const color = this.opts.colors[i] ?? "#ccc";
+    // start-of-action facing (replayStore fixes facing for the whole action); samples may skip frames
+    const prev = this.prevAction[i];
+    if (!prev || prev[0] !== actionId || actionFrame < prev[1]) this.facingAtStart[i] = facing;
+    this.prevAction[i] = [actionId, actionFrame];
+    const lastPos = this.prevPos[i];
+    this.prevPos[i] = [x, y];
+
+    const outline = flags & 1 ? "#7dd3fc" : flags & 2 ? "#fde047" : "#0b0d12";
+    const fighter: Fighter = { x, y, facing, facingAtStart: this.facingAtStart[i], actionId, actionFrame, charId, color, outline,
+      outlineWidth: 2 * (flags & 3 ? 2.5 : 1), from: lastPos };
+    const pose = drawFighter(ctx, fighter, () => this.redraw());
+    if (!pose) {
+      // no animation (yet): a body-sized capsule with a facing nose
+      ctx.fillStyle = color;
+      ctx.strokeStyle = outline;
+      ctx.lineWidth = 1.5 / s;
+      ctx.beginPath();
+      ctx.ellipse(x, y + 7, 4.5, 7, 0, 0, Math.PI * 2);
+      ctx.fill();
+      ctx.stroke();
+      ctx.beginPath();
+      ctx.moveTo(x + facing * 4, y + 10);
+      ctx.lineTo(x + facing * 8, y + 8);
+      ctx.lineTo(x + facing * 4, y + 6);
+      ctx.fill();
+    }
+    if (flags & 8 || pose?.shield) drawShield(ctx, { ...fighter, facing: pose?.face ?? facing }, shield);
+  }
+}
